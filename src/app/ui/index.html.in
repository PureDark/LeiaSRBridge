<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Titan Bridge</title>
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:">
<style>
  :root {
    --backdrop: #E6E2DB;
    --win: #FAF9F6;
    --surface: #FFFFFF;
    --ink: #1D1C1A;
    --ink-2: #5D5952;
    --ink-3: #9A958C;
    --line: #ECE8E1;
    --line-2: #E2DDD5;
    --track: #F1EEE9;
    --ok: #2E9461;
    --warn: #C98418;
    --err: #C94A3B;
    --left: #EE6B4D;
    --right: #1AA39B;
    --radius: 14px;
    --font: "Segoe UI Variable Text", "Segoe UI", "Microsoft YaHei UI", "PingFang SC", system-ui, sans-serif;
    --font-display: "Segoe UI Variable Display", "Segoe UI", "Microsoft YaHei UI", "PingFang SC", system-ui, sans-serif;
    --mono: "Cascadia Mono", "Consolas", "Microsoft YaHei UI", monospace;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    min-height: 100vh;
    background: var(--backdrop);
    font-family: var(--font);
    color: var(--ink);
    display: grid;
    place-items: center;
    padding: 48px 24px 96px;
    -webkit-font-smoothing: antialiased;
  }
  button { font: inherit; color: inherit; cursor: pointer; }
  button:disabled { cursor: not-allowed; }
  .num { font-family: var(--font-display); font-variant-numeric: tabular-nums; }

  /* ---------- 窗口 ---------- */
  .window {
    position: relative;
    width: 920px;
    max-width: 100%;
    min-height: 760px;
    background: var(--win);
    border-radius: 12px;
    box-shadow: 0 1px 0 rgba(255,255,255,.6) inset, 0 30px 80px -30px rgba(40,32,20,.35), 0 0 0 1px rgba(40,32,20,.08);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .titlebar {
    height: 38px;
    display: flex;
    align-items: center;
    padding-left: 16px;
    font-size: 12.5px;
    color: var(--ink-2);
    gap: 9px;
    user-select: none;
  }
  .titlebar .spacer { flex: 1; }
  .winbtn {
    width: 46px; height: 38px; border: 0; background: transparent;
    display: grid; place-items: center; color: var(--ink-2);
  }
  .winbtn:hover { background: rgba(0,0,0,.05); }
  .winbtn.close:hover { background: #E5483A; color: #fff; }

  .mark { width: 18px; height: 12px; position: relative; flex: none; }
  .mark i { position: absolute; top: 0; width: 12px; height: 12px; border-radius: 50%; mix-blend-mode: multiply; }
  .mark i:first-child { left: 0; background: var(--left); }
  .mark i:last-child { right: 0; background: var(--right); }

  header.nav {
    display: flex;
    align-items: flex-end;
    padding: 0 40px;
    border-bottom: 1px solid var(--line);
    height: 52px;
    gap: 28px;
  }
  .tab {
    border: 0; background: none; padding: 0 0 14px;
    font-size: 15px; color: var(--ink-3);
    position: relative;
    transition: color .15s;
  }
  .tab:hover { color: var(--ink-2); }
  .tab[aria-selected="true"] { color: var(--ink); font-weight: 600; }
  .tab[aria-selected="true"]::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--ink); border-radius: 2px;
  }
  .tab .count { font-size: 12px; color: var(--ink-3); font-weight: 400; margin-left: 4px; }
  .nav .spacer { flex: 1; }
  .nav-actions { display: flex; gap: 6px; padding-bottom: 10px; position: relative; }

  .btn {
    height: 34px; padding: 0 14px; border-radius: 9px;
    border: 1px solid var(--line-2); background: var(--surface);
    font-size: 13.5px; display: inline-flex; align-items: center; gap: 7px;
    transition: background .15s, border-color .15s, opacity .15s;
  }
  .btn:hover:not(:disabled) { border-color: #D3CDC3; background: #FDFCFA; }
  .btn:disabled { opacity: .45; }
  .btn.primary { background: var(--ink); border-color: var(--ink); color: #fff; }
  .btn.primary:hover:not(:disabled) { background: #33312D; border-color: #33312D; }
  .btn.ghost { background: transparent; border-color: transparent; color: var(--ink-2); }
  .btn.ghost:hover:not(:disabled) { background: rgba(0,0,0,.04); border-color: transparent; }
  .btn.icon { width: 34px; padding: 0; justify-content: center; }
  .btn.danger { color: var(--err); }
  .btn.danger.confirm { background: var(--err); border-color: var(--err); color: #fff; }
  .link {
    border: 0; background: none; padding: 0; font-size: 13px; color: var(--ink-2);
    display: inline-flex; align-items: center; gap: 5px;
  }
  .link:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  .menu {
    position: absolute; right: 0; top: 40px; z-index: 20;
    width: 248px; padding: 6px; border-radius: 12px;
    background: var(--surface); border: 1px solid var(--line-2);
    box-shadow: 0 16px 40px -16px rgba(40,32,20,.3);
    display: none;
  }
  .menu.open { display: block; }
  .menu button {
    width: 100%; border: 0; background: none; text-align: left;
    padding: 9px 10px; border-radius: 8px; font-size: 13.5px;
    display: flex; flex-direction: column; gap: 2px;
  }
  .menu button small { color: var(--ink-3); font-size: 12px; display: flex; align-items: center; gap: 6px; }
  .menu-title { display: flex; align-items: center; gap: 8px; }
  .badge {
    font-size: 10.5px; line-height: 1; padding: 3px 6px; border-radius: 5px;
    background: #F6EBD8; color: #8A5A12; font-weight: 500;
  }
  .menu button:hover { background: var(--track); }
  .menu hr { border: 0; border-top: 1px solid var(--line); margin: 5px 4px; }
  .menu .danger { color: var(--err); }

  main { flex: 1; position: relative; }
  .page { display: none; padding: 40px 40px 28px; animation: fade .25s ease; }
  .page.active { display: block; }
  @keyframes fade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

  /* ---------- 概览 ---------- */
  .hero { display: grid; grid-template-columns: 1fr 268px; gap: 40px; align-items: center; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12.5px; color: var(--ink-2);
    padding: 5px 11px 5px 9px; border-radius: 999px; background: var(--track);
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ink-3); flex: none; }
  .dot.ok { background: var(--ok); }
  .dot.warn { background: var(--warn); }
  .dot.err { background: var(--err); }
  .dot.pulse { animation: pulse 1.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .35; } }
  .hero h1 {
    font-family: var(--font-display);
    font-size: 38px; line-height: 1.15; font-weight: 600; letter-spacing: -.01em;
    margin: 18px 0 12px;
  }
  .hero p.lead { margin: 0; font-size: 15px; line-height: 1.7; color: var(--ink-2); max-width: 30em; }
  .hero .cta { margin-top: 24px; display: flex; gap: 12px; align-items: center; }
  .hero .cta small { color: var(--ink-3); font-size: 12.5px; }

  .viz {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 14px 14px 12px;
  }
  .viz svg { display: block; width: 100%; height: auto; }
  .viz .caption {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 12px; color: var(--ink-3); margin-top: 6px; padding: 0 2px;
  }
  .viz .caption b { font-weight: 500; color: var(--ink-2); }
  .legend { display: inline-flex; gap: 10px; }
  .legend span { display: inline-flex; align-items: center; gap: 5px; }
  .legend i { width: 6px; height: 6px; border-radius: 50%; }

  .checks {
    margin-top: 40px;
    display: grid; grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .check {
    padding: 16px 0 16px 20px; border-left: 1px solid var(--line);
    background: none; border-top: 0; border-right: 0; border-bottom: 0;
    text-align: left; display: flex; flex-direction: column; gap: 6px;
    cursor: default;
  }
  .check:first-child { border-left: 0; padding-left: 0; }
  .check .k { font-size: 12px; color: var(--ink-3); }
  .check .v { font-size: 14.5px; display: flex; align-items: center; gap: 8px; }
  .check.clickable { cursor: pointer; }
  .check.clickable .v::after {
    content: ""; width: 6px; height: 6px; margin-left: 2px;
    border-right: 1.5px solid var(--ink-3); border-top: 1.5px solid var(--ink-3); transform: rotate(45deg);
  }
  .check.clickable:hover .v { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-2); }

  .section-head {
    display: flex; align-items: baseline; justify-content: space-between;
    margin: 36px 0 12px;
  }
  .section-head h2 { font-size: 13px; font-weight: 600; color: var(--ink-2); margin: 0; letter-spacing: .02em; }
  .section-head .aside { display: flex; gap: 18px; align-items: center; font-size: 12.5px; color: var(--ink-3); }
  .saved { display: inline-flex; align-items: center; gap: 5px; transition: opacity .3s; }

  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .row {
    display: flex; align-items: center; gap: 24px;
    padding: 18px 22px;
  }
  .row + .row { border-top: 1px solid var(--line); }
  .row .text { flex: 1; min-width: 0; }
  .row .title { font-size: 15px; }
  .row .desc { font-size: 12.5px; color: var(--ink-3); margin-top: 3px; }

  .stepper { display: flex; align-items: center; gap: 4px; }
  .stepper .sbtn {
    width: 32px; height: 32px; border-radius: 50%;
    border: 1px solid var(--line-2); background: var(--surface);
    display: grid; place-items: center; color: var(--ink-2);
  }
  .stepper .sbtn:hover { background: var(--track); color: var(--ink); }
  .stepper .value {
    width: 104px; text-align: center; border: 0; background: none;
    font-size: 22px; font-weight: 500; padding: 2px 0; border-radius: 8px;
  }
  .stepper .value:hover { background: var(--track); }
  .stepper .value small { font-size: 12.5px; color: var(--ink-3); font-weight: 400; margin-left: 3px; font-family: var(--font); }
  .stepper input {
    width: 104px; text-align: center; font-size: 20px; font-family: var(--font-display);
    border: 1px solid var(--ink); border-radius: 8px; padding: 3px 0; outline: none; background: #fff;
  }
  .reset-hint { font-size: 12px; margin-right: 6px; }
  .reset-hint[hidden] { display: none; }

  .seg { display: inline-flex; background: var(--track); border-radius: 10px; padding: 3px; }
  .seg button {
    border: 0; background: none; height: 30px; min-width: 46px; padding: 0 10px;
    border-radius: 8px; font-size: 13.5px; color: var(--ink-2);
    font-family: var(--font-display); font-variant-numeric: tabular-nums;
    transition: background .15s, color .15s, box-shadow .15s;
  }
  .seg button:hover { color: var(--ink); }
  .seg button[aria-pressed="true"] {
    background: var(--surface); color: var(--ink); font-weight: 600;
    box-shadow: 0 1px 2px rgba(40,32,20,.12), 0 0 0 1px rgba(40,32,20,.04);
  }
  .seg-unit { font-size: 12.5px; color: var(--ink-3); margin-left: 8px; }

  .footline {
    margin-top: 28px; display: flex; justify-content: space-between; align-items: center;
    font-size: 12px; color: var(--ink-3);
  }
  .footline .links { display: flex; gap: 20px; }

  /* ---------- 游戏 ---------- */
  .page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .page-head h1 { font-family: var(--font-display); font-size: 26px; font-weight: 600; margin: 0 0 8px; }
  .page-head p { margin: 0; color: var(--ink-2); font-size: 14px; line-height: 1.7; max-width: 36em; }
  .notice {
    display: flex; gap: 10px; align-items: center;
    padding: 12px 16px; border-radius: 12px; background: var(--track);
    font-size: 13px; color: var(--ink-2); margin-bottom: 20px;
  }
  .game { display: flex; align-items: center; gap: 16px; padding: 14px 18px; }
  .game + .game, .game-wrap + .game-wrap { border-top: 1px solid var(--line); }
  .game .tile {
    width: 40px; height: 40px; border-radius: 10px; flex: none;
    display: grid; place-items: center; font-weight: 600; font-size: 14px; color: #fff;
  }
  .game .info { flex: 1; min-width: 0; }
  .game [data-edit], .game [data-remove] { opacity: 0; transition: opacity .15s; }
  .game-wrap:hover [data-edit], .game-wrap:hover [data-remove],
  .game-wrap:focus-within [data-edit], .game-wrap:focus-within [data-remove] { opacity: 1; }
  .game .name { font-size: 14.5px; }
  .game .path { font-size: 12px; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
  .game .args-tag { font-size: 11.5px; color: var(--ink-2); background: var(--track); padding: 2px 8px; border-radius: 6px; margin-left: 8px; font-family: var(--mono); }
  .game-edit { padding: 0 18px 16px 74px; display: none; gap: 8px; align-items: center; }
  .game-edit.open { display: flex; }
  .field {
    flex: 1; height: 34px; border: 1px solid var(--line-2); border-radius: 9px; padding: 0 12px;
    font: 13px var(--mono); background: #fff; outline: none;
  }
  .field:focus { border-color: var(--ink); }
  .empty { padding: 48px 20px; text-align: center; color: var(--ink-3); font-size: 13.5px; }
  .empty b { display: block; color: var(--ink-2); font-size: 15px; font-weight: 500; margin-bottom: 6px; }

  .switch-row { display: flex; align-items: center; gap: 16px; padding: 18px 22px; }
  .switch {
    width: 40px; height: 24px; border-radius: 999px; border: 0; padding: 0;
    background: #D9D4CB; position: relative; transition: background .2s; flex: none;
  }
  .switch::after {
    content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%;
    background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.2); transition: transform .2s;
  }
  .switch[aria-checked="true"] { background: var(--ink); }
  .switch[aria-checked="true"]::after { transform: translateX(16px); }

  /* ---------- 诊断 ---------- */
  .metrics { display: grid; grid-template-columns: repeat(3, 1fr); }
  .metric { padding: 18px 22px; }
  .metric + .metric { border-left: 1px solid var(--line); }
  .metric .k { font-size: 12px; color: var(--ink-3); display: flex; gap: 6px; align-items: baseline; }
  .metric .k em { font-style: normal; font-size: 11px; letter-spacing: .06em; }
  .metric .v { font-size: 24px; font-weight: 500; margin-top: 6px; }
  .metric .v small { font-size: 12.5px; color: var(--ink-3); font-weight: 400; margin-left: 3px; font-family: var(--font); }
  .metrics + .metrics { border-top: 1px solid var(--line); }
  .metric-group-label { padding: 14px 22px 0; font-size: 12.5px; color: var(--ink-2); font-weight: 600; }
  .metric-group-label span { color: var(--ink-3); font-weight: 400; margin-left: 6px; }
  .diag-status { padding: 14px 22px; border-top: 1px solid var(--line); display: flex; gap: 22px; font-size: 12.5px; color: var(--ink-2); flex-wrap: wrap; }
  .diag-status span { display: inline-flex; align-items: center; gap: 7px; }

  .log {
    font: 12px/1.75 var(--mono); color: var(--ink-2);
    padding: 14px 22px; height: 196px; overflow: auto; white-space: pre-wrap;
  }
  .log .t { color: var(--ink-3); margin-right: 10px; }
  .log .e { color: var(--err); }
  .card-head { display: flex; justify-content: space-between; align-items: center; padding: 14px 22px; border-bottom: 1px solid var(--line); }
  .card-head h3 { margin: 0; font-size: 13.5px; font-weight: 600; }

  /* ---------- 抽屉 ---------- */
  .scrim {
    position: absolute; inset: 38px 0 0 0; background: rgba(29,28,26,.18);
    opacity: 0; pointer-events: none; transition: opacity .2s; z-index: 30;
  }
  .scrim.open { opacity: 1; pointer-events: auto; }
  .sheet {
    position: absolute; top: 38px; right: 0; bottom: 0; width: 380px; z-index: 31;
    background: var(--win); border-left: 1px solid var(--line-2);
    box-shadow: -20px 0 50px -30px rgba(40,32,20,.4);
    transform: translateX(100%); visibility: hidden;
    transition: transform .25s cubic-bezier(.2,.8,.2,1), visibility 0s .25s;
    display: flex; flex-direction: column;
  }
  .sheet.open { transform: none; visibility: visible; transition: transform .25s cubic-bezier(.2,.8,.2,1); }
  .sheet-head { display: flex; justify-content: space-between; align-items: center; padding: 22px 24px 8px; }
  .sheet-head h2 { margin: 0; font-size: 18px; font-weight: 600; font-family: var(--font-display); }
  .sheet-body { padding: 8px 24px 24px; overflow: auto; flex: 1; font-size: 13.5px; line-height: 1.75; color: var(--ink-2); }
  .sheet-body p { margin: 0 0 14px; }
  .sheet-foot { padding: 18px 24px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; }
  .sheet-foot .btn { justify-content: center; height: 38px; }
  .foot-note { color: var(--ink-3); font-size: 12px; text-align: center; }
  .hub-path { font: 12px var(--mono); color: var(--ink-3); margin: -10px 0 18px 2px; word-break: break-all; }
  .state-line {
    display: flex; align-items: center; gap: 10px; padding: 14px 16px; margin: 6px 0 18px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px; color: var(--ink); font-size: 14px;
  }
  .steps { margin: 0 0 14px; padding: 0; list-style: none; counter-reset: s; }
  .steps li { counter-increment: s; display: flex; gap: 12px; margin-bottom: 10px; }
  .steps li::before {
    content: counter(s); flex: none; width: 20px; height: 20px; border-radius: 50%;
    background: var(--track); color: var(--ink-2); font-size: 11.5px; display: grid; place-items: center; margin-top: 3px;
  }
  .keys { list-style: none; margin: 4px 0 0; padding: 0; }
  .keys li { display: flex; justify-content: space-between; align-items: center; padding: 13px 0; border-bottom: 1px solid var(--line); color: var(--ink); }
  .keys li:last-child { border-bottom: 0; }
  kbd {
    font: 11.5px var(--font); color: var(--ink-2);
    background: var(--surface); border: 1px solid var(--line-2); border-bottom-width: 2px;
    border-radius: 6px; padding: 2px 7px; margin-left: 3px;
  }

  /* ---------- 提示 ---------- */
  .toast {
    position: absolute; left: 50%; bottom: 22px; z-index: 40;
    transform: translate(-50%, 12px); opacity: 0; pointer-events: none;
    background: var(--ink); color: #fff; font-size: 13px; padding: 10px 16px; border-radius: 10px;
    box-shadow: 0 12px 30px -12px rgba(0,0,0,.5);
    transition: opacity .2s, transform .2s; max-width: 80%; text-align: center;
  }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }

  /* ---------- 设计稿控制（不属于界面） ---------- */
  .design-ctl {
    position: fixed; left: 20px; bottom: 20px;
    display: flex; align-items: center; gap: 12px;
    background: rgba(255,255,255,.75); backdrop-filter: blur(8px);
    border: 1px dashed #BDB6AA; border-radius: 12px; padding: 10px 14px;
    font-size: 12.5px; color: var(--ink-2);
  }
  .design-ctl select { font: inherit; padding: 4px 8px; border-radius: 7px; border: 1px solid var(--line-2); background: #fff; }
  .design-ctl b { color: var(--ink); font-weight: 600; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .checks { grid-template-columns: repeat(2, 1fr); }
    .check:nth-child(3) { border-left: 0; padding-left: 0; }
    .checks .check:nth-child(n+3) { border-top: 1px solid var(--line); }
    .row { flex-wrap: wrap; }
    .page, header.nav { padding-left: 22px; padding-right: 22px; }
    .metrics { grid-template-columns: 1fr; }
    .metric + .metric { border-left: 0; border-top: 1px solid var(--line); }
    .sheet { width: 100%; }
  }
/* Native host owns the outside window, shadow and DPI. Design content is unchanged. */
  html, body { width:100%; height:100%; }
  body { display:block; padding:0; min-height:0; background:var(--win); }
  .window { width:100%; max-width:none; min-height:100vh; border-radius:0; box-shadow:none; }
  .titlebar { touch-action:none; }
  button:focus-visible { outline:2px solid var(--right); outline-offset:3px; }
</style>
</head>
<body>

<div class="window" id="win">
  <div class="titlebar">
    <span class="mark"><i></i><i></i></span>
    <span>Titan Bridge</span>
    <span class="spacer"></span>
    <button class="winbtn" title="最小化" data-action="minimize">
      <svg width="10" height="10"><path d="M0 5h10" stroke="currentColor"/></svg>
    </button>
    <button class="winbtn close" title="关闭到托盘" data-action="hide">
      <svg width="10" height="10"><path d="M0 0l10 10M10 0L0 10" stroke="currentColor"/></svg>
    </button>
  </div>

  <header class="nav" role="tablist">
    <button class="tab" role="tab" data-page="overview" aria-selected="true">概览</button>
    <button class="tab" role="tab" data-page="games" aria-selected="false">兼容列表<span class="count" id="gameCount"></span></button>
    <button class="tab" role="tab" data-page="diag" aria-selected="false">诊断</button>
    <span class="spacer"></span>
    <div class="nav-actions">
      <button class="btn ghost" data-action="hide">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 10.5h10M8 2.5v6m0 0L5.5 6M8 8.5 10.5 6"/><path d="M2.5 13.5h11"/></svg>
        后台运行
      </button>
      <button class="btn ghost icon" id="menuBtn" title="更多">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><circle cx="3.5" cy="8" r="1.3"/><circle cx="8" cy="8" r="1.3"/><circle cx="12.5" cy="8" r="1.3"/></svg>
      </button>
      <div class="menu" id="menu">
        <button data-action="sheet-integration">系统接入与启动<small>开机自启动 · 免列表接入</small></button>
        <button data-action="sheet-odyssey">
          <span class="menu-title">Odyssey 3D Hub 兼容启动<span class="badge">实验</span></span>
          <small id="hubMenuHint"></small>
        </button>
        <hr>
        <button data-action="keys">快捷键<small>后台运行时仍可调节</small></button>
        <button data-action="logs">打开日志文件夹<small>logs\</small></button>
        <hr>
        <button class="danger" data-action="exit">退出转接器<small>结束后台，游戏将无法取得设备</small></button>
      </div>
    </div>
  </header>

  <main>
    <!-- 概览 -->
    <section class="page active" id="page-overview">
      <div class="hero">
        <div>
          <span class="chip"><span class="dot" id="heroDot"></span><span id="heroChip"></span></span>
          <h1 id="heroTitle"></h1>
          <p class="lead" id="heroLead"></p>
          <div class="cta" id="heroCta"></div>
        </div>
        <div class="viz" aria-label="头部位置示意">
          <svg viewBox="0 0 240 168" id="vizSvg">
            <defs>
              <radialGradient id="glow" cx="50%" cy="50%" r="50%">
                <stop offset="0" stop-color="#F1EEE9"/>
                <stop offset="1" stop-color="#F1EEE9" stop-opacity="0"/>
              </radialGradient>
            </defs>
            <g id="vizField">
              <circle cx="120" cy="82" r="78" fill="url(#glow)"/>
              <circle cx="120" cy="82" r="70" fill="none" stroke="#ECE8E1"/>
              <circle cx="120" cy="82" r="46" fill="none" stroke="#ECE8E1"/>
              <circle cx="120" cy="82" r="22" fill="none" stroke="#E2DDD5" stroke-dasharray="2 3"/>
              <path d="M120 6v8M120 150v8M34 82h8M198 82h8" stroke="#E2DDD5"/>
            </g>
            <g id="vizHead">
              <g id="vizFace">
                <circle r="30" fill="#FFFFFF" stroke="#1D1C1A" stroke-width="1.4" id="vizOutline"/>
                <circle id="eyeL" cx="-10" cy="-3" r="3.4" fill="var(--left)"/>
                <circle id="eyeR" cx="10" cy="-3" r="3.4" fill="var(--right)"/>
              </g>
            </g>
            <text id="vizIdle" x="120" y="87" text-anchor="middle" font-size="12" fill="#9A958C" style="display:none"></text>
          </svg>
          <div class="caption">
            <b id="vizCaption" class="num"></b>
            <span class="legend"><span><i style="background:var(--left)"></i>左眼</span><span><i style="background:var(--right)"></i>右眼</span></span>
          </div>
        </div>
      </div>

      <div class="checks" id="checks"></div>

      <div class="section-head">
        <h2>画面微调</h2>
        <div class="aside">
          <span class="saved" id="saved">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m2.5 6.2 2.3 2.3 4.7-5"/></svg>
            自动保存
          </span>
          <button class="link" data-action="stereo">交织测试
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 1.5h5.5V7M8.5 1.5 1.5 8.5"/></svg>
          </button>
        </div>
      </div>

      <div class="card">
        <div class="row">
          <div class="text">
            <div class="title">水平补偿</div>
            <div class="desc">修正左右眼画面的静态错位，对所有游戏生效</div>
          </div>
          <button class="link reset-hint" id="offsetReset" hidden>恢复 +8.0</button>
          <div class="stepper">
            <button class="sbtn" data-step="-5" title="−0.5 mm（按住 Shift 为 −0.1）">
              <svg width="12" height="12"><path d="M2 6h8" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
            <button class="value num" id="offsetValue" title="点击输入精确数值（−30 ～ +30）"></button>
            <button class="sbtn" data-step="5" title="+0.5 mm（按住 Shift 为 +0.1）">
              <svg width="12" height="12"><path d="M2 6h8M6 2v8" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
          </div>
        </div>
        <div class="row">
          <div class="text">
            <div class="title">移动预测</div>
            <div class="desc">头部左右移动时提前补偿，减少串扰</div>
          </div>
          <div style="display:flex;align-items:center">
            <div class="seg" id="predSeg">
              <button data-pred="0">关</button>
              <button data-pred="10">10</button>
              <button data-pred="20">20</button>
              <button data-pred="30">30</button>
              <button data-pred="40">40</button>
            </div>
            <span class="seg-unit">ms</span>
          </div>
        </div>
      </div>

      <div class="footline">
        <div class="links">
          <button class="link" data-action="keys">快捷键</button>
          <button class="link" data-action="guide">使用说明</button>
        </div>
        <span>v@TITAN_UI_VERSION@ · SDK 1.34.10 · x64 · DX11 / DX12</span>
      </div>
    </section>

    <!-- 兼容列表 -->
    <section class="page" id="page-games">
      <div class="page-head">
        <div>
          <h1>兼容列表</h1>
          <p>大多数游戏不需要添加。只有当游戏自带 SDK、使用绝对路径或免列表接入不生效时，才在这里通过预加载启动。</p>
        </div>
        <div style="display:flex;gap:8px;flex:none">
          <button class="btn ghost" data-action="attach-now" title="扫描列表中已经在运行的游戏并注入">接管已运行的</button>
          <button class="btn primary" data-action="add-game">
            <svg width="12" height="12"><path d="M1 6h10M6 1v10" stroke="currentColor" stroke-width="1.6"/></svg>
            添加游戏
          </button>
        </div>
      </div>

      <div class="card" id="gameList"></div>

      <div class="card" style="margin-top:16px">
        <div class="switch-row">
          <div class="row-text" style="flex:1">
            <div style="font-size:15px">自动接管列表中的游戏</div>
            <div style="font-size:12.5px;color:var(--ink-3);margin-top:3px">检测到列表中的游戏运行时自动注入。启用或恢复系统接入后会自动关闭。</div>
          </div>
          <button class="switch" role="switch" id="autoSwitch" aria-checked="false"></button>
        </div>
      </div>
    </section>

    <!-- 诊断 -->
    <section class="page" id="page-diag">
      <div class="card">
        <div class="metric-group-label">眼位中心<span>显示坐标系 · 毫米</span></div>
        <div class="metrics">
          <div class="metric"><div class="k">水平 <em>X</em></div><div class="v num" id="mX">—</div></div>
          <div class="metric"><div class="k">垂直 <em>Y</em></div><div class="v num" id="mY">—</div></div>
          <div class="metric"><div class="k">距离 <em>Z</em></div><div class="v num" id="mZ">—</div></div>
        </div>
        <div class="metric-group-label" style="border-top:1px solid var(--line)">头部旋转<span>估算 · 度</span></div>
        <div class="metrics" style="border-top:0">
          <div class="metric"><div class="k">俯仰 <em>PITCH</em></div><div class="v num" id="mP">—</div></div>
          <div class="metric"><div class="k">左右 <em>YAW</em></div><div class="v num" id="mYaw">—</div></div>
          <div class="metric"><div class="k">侧倾 <em>ROLL</em></div><div class="v num" id="mR">—</div></div>
        </div>
        <div class="diag-status" id="diagStatus"></div>
      </div>

      <div class="card" style="margin-top:16px">
        <div class="card-head">
          <h3>运行日志</h3>
          <div style="display:flex;gap:16px">
            <button class="link" data-action="clear-log">清空显示</button>
            <button class="link" data-action="logs">打开日志文件夹</button>
          </div>
        </div>
        <div class="log" id="log"></div>
      </div>
    </section>
  </main>

  <div class="scrim" id="scrim"></div>
  <aside class="sheet" id="sheet" aria-hidden="true">
    <div class="sheet-head">
      <h2 id="sheetTitle"></h2>
      <button class="btn ghost icon" data-action="close-sheet" title="关闭">
        <svg width="12" height="12"><path d="M1 1l10 10M11 1 1 11" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    </div>
    <div class="sheet-body" id="sheetBody"></div>
    <div class="sheet-foot" id="sheetFoot"></div>
  </aside>

  <div class="toast" id="toast"></div>
</div>

<script>
window.addEventListener("error", e => chrome.webview.postMessage({action:"ui-error",text:e.message,line:e.lineno}));
(() => {
  const $ = (s, root = document) => root.querySelector(s);
  const $$ = (s, root = document) => [...root.querySelectorAll(s)];

  const send = (action, extra = {}) => window.chrome.webview.postMessage({action, ...extra});
  const state = {
    device:"init", displayName:"", hub:"missing", hubPath:"", hubSession:false,
    hubLaunching:false, face:false, integrated:false, integrating:false,
    offset:80, prediction:40, lastPrediction:40, autoAttach:false, page:"overview",
    sheet:null, confirmRestore:false, games:[], editing:-1,
    calibration:false, lens:false, rotationValid:false, eyeLabel:"不可用",
    clients:"—", mock:false, message:""
  };

  const deviceReady = () => state.device === "ready";
  const displayLabel = () => state.displayName || "裸眼 3D 显示器";

  /* ---------- 提示与日志 ---------- */
  let toastTimer;
  function toast(text) {
    const el = $("#toast");
    el.textContent = text;
    el.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.remove("show"), 2600);
  }

  const logLines = [];
  function renderLog() {
    const el = $("#log");
    el.innerHTML = "";
    for (const line of logLines) {
      const div = document.createElement("div");
      const ts = document.createElement("span");
      ts.className = "t";
      ts.textContent = line.t;
      div.append(ts, document.createTextNode(line.text));
      if (line.error) div.className = "e";
      el.append(div);
    }
    el.scrollTop = el.scrollHeight;
  }

  let savedTimer;
  function saved() {
    const el = $("#saved");
    el.style.color = "var(--ok)";
    clearTimeout(savedTimer);
    savedTimer = setTimeout(() => (el.style.color = ""), 900);
  }

  /* ---------- 概览 ---------- */
  function renderHero() {
    const dot = $("#heroDot"), chip = $("#heroChip"), title = $("#heroTitle"), lead = $("#heroLead"), cta = $("#heroCta");
    dot.className = "dot";
    cta.innerHTML = "";

    if (state.device === "error") {
      dot.classList.add("err");
      chip.textContent = "设备异常";
      title.textContent = "设备暂时不可用";
      lead.textContent = state.message || "请在诊断页查看设备日志。";
    } else if (state.device === "init") {
      dot.classList.add("warn", "pulse");
      chip.textContent = "正在初始化";
      title.textContent = "正在连接显示器…";
      lead.textContent = "读取设备标定并启动眼追，通常只需几秒。";
    } else if (state.device === "nodevice") {
      dot.classList.add("err");
      chip.textContent = "未找到显示器";
      title.textContent = "没有找到裸眼 3D 显示器";
      lead.textContent = "确认显示器的视频线和 USB 线都已连接并开机，程序会自动重试。";
    } else if (state.device === "busy") {
      dot.classList.add("err");
      chip.textContent = "设备被占用";
      title.textContent = "显示器正被其他程序使用";
      lead.textContent = "关闭 DepthTransformerPlus 等占用摄像头或镜片的 3D 程序后，程序会自动重试。";
    } else if (!state.integrated) {
      dot.classList.add("ok");
      chip.textContent = `${displayLabel()} · 已连接`;
      title.textContent = "还差一步";
      lead.textContent = "启用后，游戏照常从 Steam 或快捷方式启动，无需逐个添加。";
      const b = document.createElement("button");
      b.className = "btn primary";
      b.textContent = state.integrating ? "等待管理员确认…" : "启用免列表接入";
      b.disabled = state.integrating;
      b.onclick = enableIntegration;
      const s = document.createElement("small");
      s.textContent = "首次设置需要管理员权限";
      cta.append(b, s);
    } else if (!state.face) {
      dot.classList.add("ok");
      chip.textContent = `${displayLabel()} · 已连接`;
      title.textContent = "暂时没有看到你";
      lead.textContent = "3D 照常显示，暂按保持或默认眼位交织；正对屏幕即可恢复跟踪。";
    } else {
      dot.classList.add("ok");
      chip.textContent = `${displayLabel()} · 已连接`;
      title.textContent = "一切就绪";
      lead.textContent = "照常启动游戏，在游戏的 3D 选项中选择 LeiaSR 即可。";
    }
  }

  function renderChecks() {
    const ready = deviceReady();
    const display = {
      ready: ["ok", state.displayName || "已连接"], init: ["warn pulse", "连接中"], nodevice: ["err", "未找到"], busy: ["err", "被占用"], error:["err","异常"],
    }[state.device];
    const items = [
      { k: "显示器", cls: display[0], v: display[1] },
      { k: "设备标定", cls: ready ? "ok" : "", v: ready ? "可用" : "—" },
      { k: "眼位跟踪", cls: ready ? (state.face ? "ok" : "warn") : "", v: ready ? state.eyeLabel : "—" },
      { k: "免列表接入", cls: state.integrated ? "ok" : "warn", v: state.integrated ? "已启用" : "未启用", click: true },
    ];
    const root = $("#checks");
    root.innerHTML = "";
    for (const item of items) {
      const el = document.createElement("button");
      el.className = "check" + (item.click ? " clickable" : "");
      el.tabIndex = item.click ? 0 : -1;
      el.innerHTML = `<span class="k"></span><span class="v"><span class="dot ${item.cls}"></span><span></span></span>`;
      el.querySelector(".k").textContent = item.k;
      el.querySelector(".v span:last-child").textContent = item.v;
      if (item.click) el.onclick = () => openSheet("integration");
      root.append(el);
    }
  }

  function renderOffset() {
    const v = state.offset / 10;
    const text = (v > 0 ? "+" : v < 0 ? "−" : "") + Math.abs(v).toFixed(1);
    const btn = $("#offsetValue");
    if (btn) btn.innerHTML = `${text}<small>mm</small>`;
    $("#offsetReset").hidden = state.offset === 80;
  }

  function setOffset(tenths, source) {
    state.offset = Math.max(-300, Math.min(300, Math.round(tenths)));
    renderOffset();
    send("offset", {value:state.offset});
    if (source === "hotkey") toast(`水平补偿 ${(state.offset / 10).toFixed(1)} mm`);
  }

  function editOffset() {
    const btn = $("#offsetValue");
    const input = document.createElement("input");
    input.value = (state.offset / 10).toFixed(1);
    input.className = "num";
    btn.replaceWith(input);
    input.focus();
    input.select();
    let done = false;
    const finish = commit => {
      if (done) return;
      done = true;
      if (commit) {
        const value = Number(input.value.replace("−", "-").replace("+", ""));
        if (!Number.isFinite(value) || value < -30 || value > 30) toast("请输入 −30 到 +30 mm 之间的数值");
        else setOffset(value * 10);
      }
      input.replaceWith(btn);
      renderOffset();
    };
    input.addEventListener("keydown", e => {
      if (e.key === "Enter") finish(true);
      if (e.key === "Escape") finish(false);
    });
    input.addEventListener("blur", () => finish(true));
  }

  function setPrediction(ms, source) {
    state.prediction = ms;
    if (ms) state.lastPrediction = ms;
    $$("#predSeg button").forEach(b => b.setAttribute("aria-pressed", String(Number(b.dataset.pred) === ms)));
    send("prediction", {value:ms});
    if (source === "hotkey") toast(ms ? `移动预测 ${ms} ms` : "移动预测已关闭");
  }

  /* ---------- 头部示意 ---------- */
  const pose = { x: 0, y: 0, z: 600, pitch: 0, yaw: 0, roll: 0 };


  // Visual presentation only. Diagnostics and LeiaSR retain the original pose.
  const viz = { x:0, y:0, scale:1, pitch:0, yaw:0, roll:0 };
  let vizFrame = 0, vizLastTime = 0;
  function animateViz(now) {
    vizFrame = 0;
    if (state.page !== "overview" || document.hidden) { vizLastTime = 0; return; }
    const dt = vizLastTime ? Math.min(now - vizLastTime, 100) : 16;
    vizLastTime = now;
    const blend = 1 - Math.exp(-dt / 40);
    const target = {
      x: 52 * Math.tanh(pose.x * 0.18 / 52),
      y: 40 * Math.tanh(pose.y * 0.18 / 40),
      scale: Math.max(0.85, Math.min(1.15, 600 / Math.max(200, pose.z))),
      pitch: Math.max(-20, Math.min(20, pose.pitch)),
      yaw: Math.max(-20, Math.min(20, pose.yaw)),
      roll: pose.roll
    };
    for (const key of Object.keys(viz)) {
      const delta = key === "roll" ? ((target[key] - viz[key] + 540) % 360) - 180 : target[key] - viz[key];
      viz[key] += delta * blend;
    }
    drawViz();
    vizFrame = requestAnimationFrame(animateViz);
  }
  function startViz() {
    if (!vizFrame && state.page === "overview" && !document.hidden) vizFrame = requestAnimationFrame(animateViz);
  }
  document.addEventListener("visibilitychange", () => { vizLastTime = 0; startViz(); });

  function drawViz() {
    const head = $("#vizHead"), face = $("#vizFace"), outline = $("#vizOutline"), idle = $("#vizIdle"), field = $("#vizField");
    const ready = deviceReady();
    field.style.opacity = ready ? 1 : 0.45;
    if (!ready) {
      head.style.display = "none";
      idle.style.display = "";
      idle.textContent = state.device === "init" ? "等待眼追…" : "无设备";
      return;
    }
    head.style.display = "";
    idle.style.display = "none";
    if (!state.face) {
      head.setAttribute("transform", "translate(120 82)");
      face.setAttribute("transform", "");
      outline.setAttribute("stroke-dasharray", "3 4");
      outline.setAttribute("stroke", "#9A958C");
      head.style.opacity = 0.7;
      $("#eyeL").setAttribute("cx", -10); $("#eyeR").setAttribute("cx", 10);
      $("#eyeL").setAttribute("cy", -3); $("#eyeR").setAttribute("cy", -3);
      return;
    }
    outline.removeAttribute("stroke-dasharray");
    outline.setAttribute("stroke", "#1D1C1A");
    head.style.opacity = 1;
    head.setAttribute("transform", `translate(${(120 + viz.x).toFixed(2)} ${(82 - viz.y).toFixed(2)}) scale(${viz.scale.toFixed(3)})`);
    face.setAttribute("transform", `rotate(${viz.roll.toFixed(2)})`);
    const ex = viz.yaw * 0.45, ey = -3 - viz.pitch * 0.5;
    $("#eyeL").setAttribute("cx", (-10 + ex).toFixed(2));
    $("#eyeR").setAttribute("cx", (10 + ex).toFixed(2));
    $("#eyeL").setAttribute("cy", ey.toFixed(2));
    $("#eyeR").setAttribute("cy", ey.toFixed(2));
  }

  function renderCaption() {
    const cap = $("#vizCaption");
    if (!deviceReady()) cap.textContent = "—";
    else if (!state.face) cap.textContent = state.eyeLabel + " · " + Math.round(pose.z / 10) + " cm";
    else cap.textContent = `距屏幕 ${Math.round(pose.z / 10)} cm`;
  }

  /* ---------- 诊断 ---------- */
  function signed(v, digits = 1) {
    const s = Math.abs(v).toFixed(digits);
    return (v > 0.05 ? "+" : v < -0.05 ? "−" : "") + s;
  }
  function renderDiag() {
    const ready = deviceReady();
    const pos = pose;
    const set = (id, text, unit) => ($("#" + id).innerHTML = text === "—" ? "—" : `${text}<small>${unit}</small>`);
    set("mX", ready ? signed(pos.x) : "—", "mm");
    set("mY", ready ? signed(pos.y) : "—", "mm");
    set("mZ", ready ? pos.z.toFixed(0) : "—", "mm");
    set("mP", state.rotationValid ? signed(pose.pitch) : "—", "°");
    set("mYaw", state.rotationValid ? signed(pose.yaw) : "—", "°");
    set("mR", state.rotationValid ? signed(pose.roll) : "—", "°");

    const items = [
      [ready ? (state.face ? "ok" : "warn") : "", "眼位", state.eyeLabel],
      [ready ? "ok" : "", "3D 请求", ready ? (state.lens ? "开启（软件请求）" : "关闭") : "—"],
      [ready ? "ok" : "", "标定", state.calibration ? "可用" : "不可用"],
      ["", "客户端", state.clients],
    ];
    const root = $("#diagStatus");
    root.innerHTML = "";
    for (const [cls, k, v] of items) {
      const span = document.createElement("span");
      span.innerHTML = `<span class="dot ${cls}"></span>`;
      span.append(`${k}：${v}`);
      root.append(span);
    }
  }

  /* ---------- 兼容列表 ---------- */
  function renderGames() {
    $("#gameCount").textContent = state.games.length ? String(state.games.length) : "";
    const root = $("#gameList");
    root.innerHTML = "";
    if (!state.games.length) {
      root.innerHTML = `<div class="empty"><b>列表是空的</b>这通常意味着一切正常——免列表接入已经覆盖了你的游戏。</div>`;
      return;
    }
    state.games.forEach((g, i) => {
      const wrap = document.createElement("div");
      wrap.className = "game-wrap";
      wrap.innerHTML = `
        <div class="game">
          <div class="tile"></div>
          <div class="info">
            <div class="name"></div>
            <div class="path"></div>
          </div>
          <button class="btn ghost" data-edit>参数</button>
          <button class="btn ghost danger" data-remove>移除</button>
          <button class="btn" data-launch>启动</button>
        </div>
        <div class="game-edit">
          <input class="field" placeholder="启动参数（可选）">
          <button class="btn" data-save>保存</button>
        </div>`;
      const tile = $(".tile", wrap);
      tile.textContent = g.exe.slice(0, 2).toUpperCase();
      tile.style.background = g.color;
      $(".name", wrap).textContent = g.exe.replace(/\.exe$/i, "");
      if (g.args) {
        const tag = document.createElement("span");
        tag.className = "args-tag";
        tag.textContent = g.args;
        $(".name", wrap).append(tag);
      }
      $(".path", wrap).textContent = g.path;
      $(".path", wrap).title = g.path;
      const launch = $("[data-launch]", wrap);
      launch.disabled = !deviceReady();
      launch.title = deviceReady() ? "以预加载方式启动" : "设备就绪后才能启动";
      launch.onclick = () => {
        send("launch", {index:i});
        toast(`正在启动 ${g.exe}`);
      };
      const edit = $(".game-edit", wrap);
      if (state.editing === i) edit.classList.add("open");
      $(".field", wrap).value = g.args;
      $("[data-edit]", wrap).onclick = () => {
        state.editing = state.editing === i ? -1 : i;
        renderGames();
        if (state.editing === i) $$(".game-edit .field")[i].focus();
      };
      const save = () => { g.args = $(".field", wrap).value.trim(); state.editing = -1; send("save-game", {index:i, args:g.args}); renderGames(); };
      $("[data-save]", wrap).onclick = save;
      $(".field", wrap).addEventListener("keydown", e => e.key === "Enter" && save());
      $("[data-remove]", wrap).onclick = () => {
        send("remove-game", {index:i});
        state.games.splice(i, 1);
        state.editing = -1;
        renderGames();
        toast(`已从列表移除 ${g.exe}`);
      };
      root.append(wrap);
    });
  }

  function addGame() { send("add-game"); }

  function setAutoAttach(on) {
    send("auto", {value:on});
  }

  /* ---------- 系统接入 ---------- */
  function enableIntegration() { send("enable-integration"); }

  function restoreIntegration() {
    if (!state.confirmRestore) { state.confirmRestore = true; renderSheet(); return; }
    state.confirmRestore = false;
    send("restore-integration");
  }

  /* ---------- Odyssey 3D Hub ---------- */
  function hubBlocker() {
    if (state.hub === "missing") return "没有找到 Odyssey 3D Hub";
    if (state.hub === "running") return "请先完全退出 Odyssey 3D Hub";
    if (!deviceReady()) return "等待显示器就绪";
    return "";
  }

  function renderHubMenu() {
    const hint = $("#hubMenuHint");
    hint.innerHTML = "";
    if (state.hubSession) {
      hint.innerHTML = `<span class="dot ok"></span>`;
      hint.append("运行中 · 兼容模式");
    } else {
      hint.textContent = state.hub === "missing" ? "未找到安装" : "让三星 3D 游戏库识别本机";
    }
  }

  function launchHub() { if (!hubBlocker() && !state.hubLaunching) send("hub"); }

  function sheetButton(label, cls, onclick, disabled = false) {
    const b = document.createElement("button");
    b.className = "btn " + cls;
    b.textContent = label;
    b.disabled = disabled;
    b.onclick = onclick;
    return b;
  }

  function renderHubSheet(body, foot) {
    const line = state.hubSession ? ["ok", "正在以兼容模式运行"]
      : state.hub === "missing" ? ["warn", "没有找到 Odyssey 3D Hub"]
      : state.hub === "running" ? ["warn", "Odyssey 3D Hub 正在运行"]
      : ["ok", "已找到 Odyssey 3D Hub"];

    let lead;
    if (state.hubSession) {
      lead = `<p>Hub 现在会把主显示器当作 Odyssey 3D 显示器，从 Hub 里启动的游戏会自动接入桥接。关闭 Hub 即结束兼容模式。</p>`;
    } else if (state.hub === "running") {
      lead = `<p>兼容模式需要由本程序重新打开 Hub。请先退出 Hub，并在系统托盘中退出它的后台服务，然后点“重新检测”。</p>`;
    } else if (state.hub === "missing") {
      lead = `<p>默认安装位置下没有找到 Hub。如果装在其他位置，请手动选择 Odyssey3DHubUI.exe。</p>`;
    } else {
      lead = `<p>以兼容模式打开三星的 Odyssey 3D Hub，让它把这台裸眼 3D 显示器当作 Odyssey 3D 显示器，之后直接在 Hub 里启动游戏。</p>
        <ol class="steps">
          <li>完全退出 Odyssey 3D Hub，包括托盘中的后台服务</li>
          <li>把裸眼 3D 显示器设为 Windows 主显示器</li>
          <li>点击下方按钮，然后在 Hub 中启动游戏</li>
        </ol>`;
    }

    body.innerHTML = `
      <div class="state-line"><span class="dot ${line[0]}"></span><span></span><span class="badge" style="margin-left:auto">实验</span></div>
      <div class="hub-path"></div>
      ${lead}
      <p style="color:var(--ink-3);font-size:12.5px">不连接三星设备，不写入固件或显示器标定；只对这次打开的 Hub 及其启动的游戏生效，不改动 Hub 的安装。3D 输出效果仍在验证中。</p>`;
    $(".state-line span:nth-child(2)", body).textContent = line[1];
    const path = $(".hub-path", body);
    if (state.hub === "missing") path.remove();
    else path.textContent = state.hubPath;

    if (state.hubSession) {
      foot.append(sheetButton("查看兼容日志", "", () => send("logs")));
    } else if (state.hub === "missing") {
      foot.append(sheetButton("选择 Odyssey3DHubUI.exe…", "primary", () => {
        send("select-hub");
      }));
    } else if (state.hub === "running") {
      foot.append(sheetButton("重新检测", "primary", () => {
        send("refresh-hub");
      }));
    } else {
      const blocker = hubBlocker();
      foot.append(sheetButton(state.hubLaunching ? "正在启动…" : "兼容启动 Odyssey 3D Hub", "primary", launchHub,
        Boolean(blocker) || state.hubLaunching));
      if (blocker) {
        const note = document.createElement("small");
        note.className = "foot-note";
        note.textContent = blocker;
        foot.append(note);
      }
    }
  }

  /* ---------- 抽屉 ---------- */
  function openSheet(kind) {
    state.sheet = kind;
    state.confirmRestore = false;
    renderSheet();
    $("#sheet").classList.add("open");
    $("#scrim").classList.add("open");
    $("#sheet").setAttribute("aria-hidden", "false");
    $("#menu").classList.remove("open");
  }
  function closeSheet() {
    state.sheet = null;
    $("#sheet").classList.remove("open");
    $("#scrim").classList.remove("open");
    $("#sheet").setAttribute("aria-hidden", "true");
  }
  function renderSheet() {
    const title = $("#sheetTitle"), body = $("#sheetBody"), foot = $("#sheetFoot");
    foot.innerHTML = "";
    foot.style.display = "";
    if (state.sheet === "integration") {
      title.textContent = "系统接入与启动";
      const on = state.integrated;
      body.innerHTML = `
        <div class="state-line"><span class="dot ${on ? "ok" : "warn"}"></span>${on ? "免列表接入已启用" : "免列表接入未启用"}</div>
        <p>${on
          ? "游戏会通过系统运行库路径自动使用桥接，不需要添加到兼容列表。此配置已永久保存，关机重启后仍有效。保持本程序在后台运行即可。"
          : "启用后，SDK 1.34.10 / x64 / DX12 的游戏会自动使用桥接。首次授权后永久保存，无需每次启动重新授权。"}</p>
        ${on ? `<p>如果你也在使用真实的 Leia 显示器，或准备删除、移动桥接目录，请先恢复原厂接入。</p>`
             : `<ol class="steps"><li>点击下方按钮并允许管理员提示</li><li>完全退出并重新打开 Steam 等启动器</li><li>正常启动游戏，选择 LeiaSR</li></ol>`}
        <p style="color:var(--ink-3);font-size:12.5px">更换到新目录后，在新版本中再启用一次即可，旧条目会被自动替换。</p>`;
      const startup=document.createElement("div");
      startup.className="card";
      startup.style.margin="18px 0";
      startup.innerHTML=`<div class="switch-row" style="padding:16px;gap:12px">
        <div style="flex:1"><div style="color:var(--ink)">开机自启动</div>
        <div style="font-size:12px;color:var(--ink-3)">登录 Windows 后自动在托盘运行</div></div>
        <button id="startupSwitch" class="switch" role="switch" aria-label="开机自启动" aria-checked="${Boolean(state.startup)}"></button></div>`;
      $("#startupSwitch",startup).onclick=()=>send("startup",{value:!state.startup});
      body.append(startup);
      const hint=document.createElement("p");hint.style.cssText="font-size:12.5px;color:var(--ink-3)";
      hint.textContent=state.startupOther?"自启动仍指向其他版本。打开开关即可更新为当前目录。":state.integrated
        ?"同时打开开机自启动后，日常开机即可直接使用免列表接入，无需管理员提示。"
        :"自启动不代替免列表接入配置；先启用免列表接入，再打开上面的开关。";
      body.append(hint);
      if(state.startupError){const error=document.createElement("p");error.textContent=state.startupError;body.append(error);}
      if (state.integrationDetail) {
        const detail=document.createElement("p");detail.textContent=state.integrationDetail;body.append(detail);
      }
      if (on) {
        const restore = document.createElement("button");
        restore.className = "btn danger" + (state.confirmRestore ? " confirm" : "");
        restore.textContent = state.confirmRestore ? "确认恢复原厂接入" : "恢复原厂接入";
        restore.onclick = restoreIntegration;
        const reapply = document.createElement("button");
        reapply.className = "btn ghost";
        reapply.textContent = "重新登记当前目录";
        reapply.onclick = enableIntegration;
        foot.append(restore, reapply);
      } else {
        const enable = document.createElement("button");
        enable.className = "btn primary";
        enable.textContent = state.integrating ? "等待管理员确认…" : "启用免列表接入";
        enable.disabled = state.integrating;
        enable.onclick = () => { closeSheet(); enableIntegration(); };
        foot.append(enable);
      }
    } else if (state.sheet === "odyssey") {
      title.textContent = "Odyssey 3D Hub";
      renderHubSheet(body, foot);
    } else if (state.sheet === "keys") {
      title.textContent = "快捷键";
      body.innerHTML = `
        <p>窗口隐藏到托盘后依然有效，调整立即生效并自动保存。</p>
        <ul class="keys">
          <li>水平补偿 ±0.5 mm<span><kbd>Ctrl</kbd><kbd>Alt</kbd><kbd>←</kbd><kbd>→</kbd></span></li>
          <li>水平补偿 ±0.1 mm<span><kbd>Ctrl</kbd><kbd>Alt</kbd><kbd>Shift</kbd><kbd>←</kbd><kbd>→</kbd></span></li>
          <li>水平补偿归零<span><kbd>Ctrl</kbd><kbd>Alt</kbd><kbd>Home</kbd></span></li>
          <li>移动预测开 / 关<span><kbd>Ctrl</kbd><kbd>Alt</kbd><kbd>F9</kbd></span></li>
        </ul>`;
      foot.style.display = "none";
    } else if (state.sheet === "guide") {
      title.textContent = "使用说明";
      body.innerHTML = `
        <ol class="steps">
          <li>关闭其他占用摄像头或镜片的 3D 程序，运行本程序。</li>
          <li>首次使用时启用免列表接入，然后重启 Steam 等启动器。</li>
          <li>等待“一切就绪”，点击右上角“后台运行”。</li>
          <li>正常启动游戏，在 3D 选项中选择 LeiaSR。需要头部跟随时在 mod 内开启。</li>
        </ol>
        <p>关闭窗口只会隐藏到托盘；在“更多”菜单或托盘右键中选择“退出”才会结束后台。</p>
        <p style="color:var(--ink-3);font-size:12.5px">未检测到人脸时 3D 仍可显示：短暂丢失会保持上次眼位，500 ms 后使用默认位置。</p>`;
      foot.style.display = "none";
    }
  }

  /* ---------- 导航 ---------- */
  function go(page) {
    state.page = page;
    send("viz-active", {value:page === "overview"});
    startViz();
    $$(".tab").forEach(t => t.setAttribute("aria-selected", String(t.dataset.page === page)));
    $$(".page").forEach(p => p.classList.toggle("active", p.id === "page-" + page));
    if (page === "diag") renderDiag();
  }

  function renderAll() {
    renderHero();
    renderChecks();
    renderOffset();
    renderGames();
    renderCaption();
    renderDiag();
    renderHubMenu();
    drawViz();
    if (state.sheet) renderSheet();
  }

  /* ---------- 事件 ---------- */
  $$(".tab").forEach(t => (t.onclick = () => go(t.dataset.page)));

  $$("[data-step]").forEach(b => (b.onclick = e => {
    const step = Number(b.dataset.step);
    setOffset(state.offset + (e.shiftKey ? Math.sign(step) : step));
  }));
  $("#offsetValue").onclick = editOffset;
  $("#offsetReset").onclick = () => { setOffset(80); toast("已恢复推荐值 +8.0 mm"); };
  $$("#predSeg button").forEach(b => (b.onclick = () => setPrediction(Number(b.dataset.pred))));
  $("#autoSwitch").onclick = () => { setAutoAttach(!state.autoAttach); };

  $("#menuBtn").onclick = e => { e.stopPropagation(); $("#menu").classList.toggle("open"); };
  document.addEventListener("click", e => { if (!e.target.closest(".nav-actions")) $("#menu").classList.remove("open"); });
  $("#scrim").onclick = closeSheet;

  const actions = {
    hide: () => send("hide"),
    minimize: () => send("minimize"),
    exit: () => send("exit"),
    keys: () => openSheet("keys"),
    guide: () => openSheet("guide"),
    "sheet-integration": () => openSheet("integration"),
    "sheet-odyssey": () => openSheet("odyssey"),
    "close-sheet": closeSheet,
    logs: () => send("logs"),
    "clear-log": () => { logLines.length = 0; renderLog(); },
    stereo: () => send("stereo"),
    "add-game": addGame,
    "attach-now": () => {
      if (!deviceReady()) { toast("设备就绪后才能接管"); return; }
      send("attach");
      toast("已重新扫描列表中的游戏");
    },
  };
  document.addEventListener("click", e => {
    const el = e.target.closest("[data-action]");
    if (!el) return;
    const fn = actions[el.dataset.action];
    if (fn) { $("#menu").classList.remove("open"); fn(); }
  });

  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && state.sheet) closeSheet();
  });
  $(".titlebar").addEventListener("pointerdown", e => {
    if (e.button === 0 && !e.target.closest("button")) send("drag");
  });
  window.chrome.webview.addEventListener("message", ({data}) => {
    if (data.type === "log") {
      logLines.push({t:data.text.slice(0,8), text:data.text.slice(9), error:false});
      if (logLines.length > 200) logLines.shift();
      renderLog();
      return;
    }
    if (data.type === "saved") { saved(); return; }
    if (data.type === "notice") { toast(data.text); return; }
    if (data.type === "pose") { Object.assign(pose, data.pose); return; }
    if (data.type !== "state") return;
    const old = {...state};
    Object.assign(state, data.state);
    Object.assign(pose, data.pose);
    const changed = keys => keys.some(k => JSON.stringify(old[k]) !== JSON.stringify(state[k]));
    if (changed(["device","integrated","integrating","face","mock","message"])) {
      renderHero();
      if (state.mock) $("#heroChip").textContent = "离线模拟 · 不控制硬件";
    }
    if (changed(["device","face","integrated","eyeLabel"])) renderChecks();
    if (changed(["offset"])) renderOffset();
    $$("#predSeg button").forEach(b => b.setAttribute("aria-pressed", String(+b.dataset.pred === state.prediction)));
    $("#autoSwitch").setAttribute("aria-checked", String(state.autoAttach));
    if (changed(["games","device"])) renderGames();
    if (changed(["hub","hubSession","hubPath"])) renderHubMenu();
    if (state.sheet && changed(["hub","hubSession","hubLaunching","hubPath","integrated","integrating","device","integrationDetail","startup","startupOther","startupError"]))
      renderSheet();
    if (state.page === "diag") renderDiag();
    renderCaption();
  });
  renderAll();
  startViz();
  send("ready");
})();
</script>
</body>
</html>
